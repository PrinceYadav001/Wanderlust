<% layout('/layouts/boilerplate') %>

<div class="show-wrapper">
  <h1 class="show-title" style="font-size:1.8rem;">
    <i class="fa-solid fa-suitcase-rolling me-2" style="color:var(--brand, #e9405a);"></i>
    My Bookings
  </h1>

  <% if (bookings.length === 0) { %>
    <div class="text-center py-5" style="color:#aaa;">
      <i class="fa-solid fa-calendar-xmark" style="font-size:3rem; margin-bottom:1rem; display:block;"></i>
      <p style="font-size:1.1rem;">You haven't made any bookings yet.</p>
      <a href="/listings" class="btn add-btn mt-2">
        <i class="fa-solid fa-magnifying-glass me-1"></i>Explore Listings
      </a>
    </div>

  <% } else { %>

    <div class="row g-3">
      <% for (let booking of bookings) { %>
        <div class="col-md-6">
          <div class="review-form-card h-100" style="border-left: 4px solid <%= booking.status === 'confirmed' ? '#28a745' : '#dc3545' %>;">

            <!-- Listing title + image -->
            <div style="display:flex; gap:.8rem; align-items:center; margin-bottom:.8rem;">
              <% if (booking.listing && booking.listing.image) { %>
                <img src="<%= booking.listing.image.url %>" alt="listing"
                  style="width:70px; height:55px; object-fit:cover; border-radius:8px; flex-shrink:0;">
              <% } %>
              <div>
                <div style="font-weight:700;">
                  <%= booking.listing ? booking.listing.title : "Listing unavailable" %>
                </div>
                <% if (booking.listing) { %>
                  <div style="color:#888; font-size:.85rem;">
                    <i class="fa-solid fa-location-dot me-1"></i><%= booking.listing.location %>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Dates -->
            <div style="font-size:.9rem; color:#555; margin-bottom:.5rem;">
              <i class="fa-solid fa-calendar-days me-1" style="color:#e9405a;"></i>
              <%= booking.checkIn.toLocaleDateString("en-IN", {day:"numeric", month:"short", year:"numeric"}) %>
              &rarr;
              <%= booking.checkOut.toLocaleDateString("en-IN", {day:"numeric", month:"short", year:"numeric"}) %>
            </div>

            <!-- Guests & Price -->
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.8rem;">
              <span style="font-size:.85rem; color:#777;">
                <i class="fa-solid fa-users me-1"></i><%= booking.guests %> guest<%= booking.guests > 1 ? 's' : '' %>
              </span>
              <span style="font-weight:700; color:#e9405a; font-size:1.05rem;">
                &#8377;<%= booking.totalPrice.toLocaleString("en-IN") %>
              </span>
            </div>

            <!-- Status + View button -->
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <% if (booking.status === "confirmed") { %>
                <span class="badge" style="background:#28a745; font-size:.8rem; border-radius:20px; padding:.35em .7em;">
                  <i class="fa-solid fa-check me-1"></i>Confirmed
                </span>
              <% } else { %>
                <span class="badge bg-danger" style="font-size:.8rem; border-radius:20px; padding:.35em .7em;">
                  <i class="fa-solid fa-xmark me-1"></i>Cancelled
                </span>
              <% } %>
              <a href="/bookings/<%= booking._id %>" class="btn btn-sm add-btn" style="font-size:.8rem;">
                <i class="fa-solid fa-eye me-1"></i>View
              </a>
            </div>

          </div>
        </div>
      <% } %>
    </div>

  <% } %>
</div>

